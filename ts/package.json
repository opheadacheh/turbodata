{
  "name": "turbodata",
  "version": "0.1.1",
  "description": "Browser TypeScript reader for the turbodata format.",
  "license": "Apache-2.0",
  "author": "Wanjia He",
  "homepage": "https://github.com/opheadacheh/turbodata#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/opheadacheh/turbodata.git",
    "directory": "ts"
  },
  "bugs": {
    "url": "https://github.com/opheadacheh/turbodata/issues"
  },
  "keywords": [
    "turbodata",
    "container-format",
    "timeseries",
    "robotics",
    "mcap",
    "msgpack",
    "zstd"
  ],
  "type": "module",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "example:read": "tsx examples/read.ts",
    "example:sample": "tsx examples/sample.ts",
    "example:multiread": "tsx examples/multiread.ts"
  },
  "dependencies": {
    "@msgpack/msgpack": "^3.0.0",
    "fzstd": "^0.1.1"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "tsx": "^4.7.0",
    "typescript": "^5.4.0",
    "vitest": "^4.1.8"
  }
}
